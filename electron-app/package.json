{
  "name": "strategic-canvas",
  "version": "1.0.0",
  "description": "AI Strategic Coaching — desktop shell for Python backend",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.strategiccanvas.app",
    "productName": "Strategic Canvas",
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "dmg": {
      "title": "Strategic Canvas",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": ["main/**/*"],
    "extraResources": [
      { "from": "../skills/", "to": "python-backend/skills/" },
      { "from": "../config/", "to": "python-backend/config/" },
      { "from": "../models/", "to": "python-backend/models/" },
      { "from": "../engine/", "to": "python-backend/engine/" },
      { "from": "../web/", "to": "python-backend/web/" },
      { "from": "../main.py", "to": "python-backend/main.py" },
      { "from": "../requirements.txt", "to": "python-backend/requirements.txt" }
    ]
  }
}
